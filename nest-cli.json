{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/messaging-api/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/messaging-api/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/messaging-api",
  "projects": {
    "application": {
      "type": "library",
      "root": "libs/application",
      "entryFile": "index",
      "sourceRoot": "libs/application/src",
      "compilerOptions": {
        "tsConfigPath": "libs/application/tsconfig.lib.json"
      }
    },
    "backoffice-api": {
      "type": "application",
      "root": "apps/backoffice-api",
      "entryFile": "main",
      "sourceRoot": "apps/backoffice-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/backoffice-api/tsconfig.app.json"
      }
    },
    "cli": {
      "type": "application",
      "root": "apps/cli",
      "entryFile": "main",
      "sourceRoot": "apps/cli/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cli/tsconfig.app.json"
      }
    },
    "cron": {
      "type": "application",
      "root": "apps/cron",
      "entryFile": "main",
      "sourceRoot": "apps/cron/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cron/tsconfig.app.json"
      }
    },
    "framework": {
      "type": "library",
      "root": "libs/framework",
      "entryFile": "index",
      "sourceRoot": "libs/framework/src",
      "compilerOptions": {
        "tsConfigPath": "libs/framework/tsconfig.lib.json"
      }
    },
    "log-consumer": {
      "type": "application",
      "root": "apps/log-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/log-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/log-consumer/tsconfig.app.json"
      }
    },
    "messaging-api": {
      "type": "application",
      "root": "apps/messaging-api",
      "entryFile": "main",
      "sourceRoot": "apps/messaging-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/messaging-api/tsconfig.app.json"
      }
    },
    "messaging-api-openapi": {
      "type": "application",
      "root": "apps/messaging-api",
      "entryFile": "openapi/generate",
      "sourceRoot": "apps/messaging-api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/messaging-api/tsconfig.app.json",
        "deleteOutDir": false
      }
    },
    "viber-consumer-promotexter": {
      "type": "application",
      "root": "apps/viber-consumer-promotexter",
      "entryFile": "main",
      "sourceRoot": "apps/viber-consumer-promotexter/src",
      "compilerOptions": {
        "tsConfigPath": "apps/viber-consumer-promotexter/tsconfig.app.json"
      }
    }
  }
}
