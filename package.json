{
  "name": "messaging-gateway",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev:backoffice-api": "nest start backoffice-api --watch",
    "dev:messaging-api": "nest start messaging-api --watch",
    "dev:cron": "nest start cron --watch",
    "dev:log-consumer": "nest start log-consumer --watch",
    "dev:viber-consumer-promotexter": "nest start viber-consumer-promotexter --watch",
    "build:backoffice-api": "nest build backoffice-api",
    "build:messaging-api": "nest build messaging-api",
    "build:log-consumer": "nest build log-consumer",
    "build:viber-consumer-promotexter": "nest build viber-consumer-promotexter",
    "build:cli": "nest build cli",
    "build:cron": "nest build cron",
    "start:backoffice-api": "node dist/apps/backoffice-api/main",
    "start:messaging-api": "node dist/apps/messaging-api/main",
    "start:log-consumer": "node dist/apps/log-consumer/main",
    "start:viber-consumer-promotexter": "node dist/apps/viber-consumer-promotexter/main",
    "start:cron": "node dist/apps/cron/main",
    "cli": "node dist/apps/cli/main",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "lint": "oxlint --type-aware apps/ libs/ test/",
    "nest": "nest",
    "prepare": "husky",
    "type-check": "tsc -b --noemit",
    "generate:openapi:messaging-api": "nest build messaging-api-openapi && node dist/apps/messaging-api/openapi/generate.js && openapi-ts",
    "generate:proto:player-grpc": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./libs/application/src/integrations/player-grpc/types --ts_proto_opt=outputServices=nice-grpc,outputServices=generic-definitions,useExactTypes=false,snakeToCamel=true,removeEnumPrefix=true --proto_path=./node_modules/@snsoft/player-grpc/dist/protos ./node_modules/@snsoft/player-grpc/dist/protos/player.proto"
  },
  "dependencies": {
    "@alicloud/dysmsapi20180501": "^1.0.10",
    "@alicloud/openapi-client": "^0.4.15",
    "@alicloud/tea-util": "^1.4.11",
    "@bufbuild/protobuf": "^2.16.0",
    "@clickhouse/client": "^1.24.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@scalar/nestjs-api-reference": "^1.2.30",
    "@scalar/openapi-to-markdown": "^1.6.1",
    "axios": "^1.20.0",
    "chance": "^1.1.13",
    "date-fns": "^4.4.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "maskdata": "^1.3.4",
    "mongoose": "^9.11.3",
    "nest-commander": "^3.21.0",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4",
    "node-vault": "^0.13.0",
    "p-limit": "^7.3.3",
    "p-queue": "^10.0.0",
    "p-wait-for": "^7.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "pulsar-client": "^1.18.0",
    "radash": "^12.1.1",
    "rate-limiter-flexible": "^11.2.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "smpp": "0.6.0-rc.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@hey-api/openapi-ts": "^0.99.0",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.0.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@rspack/core": "^2.2.9",
    "@types/chance": "^1.1.8",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "type-fest": "^5.10.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@scarf/scarf",
      "protobufjs",
      "pulsar-client"
    ]
  }
}
